####################################################
## Generated by Chef for <%= node["hostname"] %>
####################################################

upstream grr_adminui {
<% @upstreams.each do |server| -%>
    server <%= server[:address] %> weight=<%= server[:weight] %> max_fails=<%= server[:max_fails] %> fail_timeout=<%= server[:fail_timeout] %>;
<% end -%>
}

server {
    listen 80;
    server_name grr-adminui.<%= node['redborder']['cdomain'] %> grr-adminui.service.<%= node['redborder']['cdomain'] %>;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name grr-adminui.<%= node['redborder']['cdomain'] %> grr-adminui.service.<%= node['redborder']['cdomain'] %>;

    ssl_certificate     <%= @ssl_cert %>;
    ssl_certificate_key <%= @ssl_key %>;
    ssl_session_timeout 10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    access_log /var/log/nginx/grr_access.log main;
    error_log  /var/log/nginx/grr_error.log;

    client_max_body_size 1M;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 90;
    proxy_send_timeout    90;
    proxy_read_timeout    90;

    location / {
        proxy_pass http://grr_adminui;
    }
}